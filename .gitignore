# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Cache directories
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/*
.idea/

# Build artifacts
dist/
build/
site/

# Node / Next.js (viewer). viewer/ has no .gitignore of its own.
node_modules/
viewer/.next/
viewer/.vercel/
viewer/next-env.d.ts
*.tsbuildinfo
*.log

# Next.js rewrites these on every build.
viewer/AGENTS.md
viewer/CLAUDE.md

# Generated from entries/ at build time.
viewer/src/generated/

# Private/local Cursor context — never commit
.cursor/**/*.local.mdc
.cursor/**/*.local.md

# --- Evaluation output and third-party data -----------------------------
# Shared with the other CoralMind repositories. Run state, run output and
# downloaded benchmark data are never committed.
*.burr.db
*.db
data/runs/
raw.csv
raw.json
raw.jsonl
processed.jsonl
*.mhtml
*.trace.jsonl

# pixi environments
.pixi/*
!.pixi/config.toml

# docs/ has its own default-deny .gitignore; see docs/README.md.
# `git clean -fdx` deletes ignored local files under docs/; use `git clean -fd`.
